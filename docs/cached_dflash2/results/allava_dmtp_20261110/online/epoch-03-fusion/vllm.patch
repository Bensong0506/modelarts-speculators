+    spec.draft_tokens = torch.zeros(4, 1, dtype=torch.int64, device="cuda")
+    spec.hidden_states = torch.zeros_like(feedback)
+    spec.sample_src_positions = torch.zeros(4, dtype=torch.int64, device="cuda")
+    spec.pcp_manager = None
