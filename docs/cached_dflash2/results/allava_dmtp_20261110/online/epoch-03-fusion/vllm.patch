+    spec.input_buffers = SimpleNamespace(positions=torch.arange(8, device="cuda"))
+    spec.idx_mapping = torch.tensor([3, 1, 0, 0], device="cuda")
+    spec.temperature = torch.zeros(4, device="cuda")
