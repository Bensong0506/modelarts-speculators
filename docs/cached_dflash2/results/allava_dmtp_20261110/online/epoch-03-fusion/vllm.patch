+def test_dflash_aux_captures_completed_gr_layers_without_double_injection():
+    """Feature reads must include pending MLP output without changing target state."""
+    from vllm.models.qwen4_exp.nvidia.model import Qwen4ExpModel
+
+    def combine(hidden, block, injection):
+        if block is None:
+            return hidden
+        return (
+            hidden.unflatten(-1, (2, 4)) + block[:, None, :] * injection[:, :, None]
+        ).flatten(-2)
+
+    class Layer(torch.nn.Module):
+        ple = None
+
+        def __init__(self, value):
+            super().__init__()
+            self.value = value
+            self.mlp_hyper_connection = SimpleNamespace(combine=combine)
+
+        def forward(self, hidden_states, prev_block_output, prev_injection, **kw):
+            hidden = combine(hidden_states, prev_block_output, prev_injection)
+            return (
+                hidden,
+                torch.full((hidden.shape[0], 4), self.value),
+                torch.tensor([[1.0, 2.0]]).expand(hidden.shape[0], -1),
+            )
+
+    model = object.__new__(Qwen4ExpModel)
+    torch.nn.Module.__init__(model)
+    model.config = SimpleNamespace(hc_count=2, hidden_size=4)
+    model.start_layer, model.end_layer = 0, 2
+    model.layers = torch.nn.ModuleList([Layer(1.0), Layer(2.0)])
+    model._mtp_hidden_buffer = None
+
+    def final_mix(hidden, block, injection):
+        multi = combine(hidden, block, injection)
+        return multi, multi.unflatten(-1, (2, 4)).mean(-2), None
+
+    model.hyper_connection_mixer = SimpleNamespace(combine_and_mix=final_mix)
+    inputs = torch.arange(8, dtype=torch.float32).reshape(2, 4)
+    with patch(
+        "vllm.models.qwen4_exp.nvidia.model.get_pp_group",
+        return_value=SimpleNamespace(is_first_rank=True, is_last_rank=True),
+    ):
+        model.aux_hidden_state_layers = ()
+        baseline = model(None, torch.arange(2), inputs_embeds=inputs)
+        model.aux_hidden_state_layers = (1, 2)
+        actual, features = model(None, torch.arange(2), inputs_embeds=inputs)
+
+    torch.testing.assert_close(actual, baseline, rtol=0, atol=0)
+    torch.testing.assert_close(features[0], inputs + 1.5)
+    torch.testing.assert_close(features[1], inputs + 4.5)
